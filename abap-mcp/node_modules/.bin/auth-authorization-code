#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -x "$basedir/tsx" ]; then
  exec "$basedir/tsx"  "$basedir/../@mcp-abap-adt/auth-providers/bin/auth-authorization-code.ts" "$@"
else 
  exec tsx  "$basedir/../@mcp-abap-adt/auth-providers/bin/auth-authorization-code.ts" "$@"
fi
